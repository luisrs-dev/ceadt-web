---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  width?: 'content' | 'reading';
}

const { width = 'content', class: className, ...attributes } = Astro.props;
const widths = { content: 'max-w-content', reading: 'max-w-reading' };
---

<div {...attributes} class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', widths[width], className]}>
  <slot />
</div>
