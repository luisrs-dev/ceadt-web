---
interface Props {
  title: string;
  eyebrow?: string;
  size?: 'standard' | 'editorial';
  description?: string;
  id?: string;
  level?: 'h2' | 'h3';
  align?: 'start' | 'center';
  class?: string;
}

const { title, eyebrow, size = 'standard', description, id, level: Heading = 'h2', align = 'start', class: className } = Astro.props;
---

<div class:list={['max-w-reading', { 'mx-auto text-center': align === 'center' }, className]}>
  {eyebrow && <p class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.14em] text-primary sm:text-sm"><span aria-hidden="true" class="h-0.5 w-7 shrink-0 bg-secondary"></span>{eyebrow}</p>}
  <Heading id={id} class:list={['font-semibold tracking-tight text-foreground text-balance', Heading === 'h2' ? (size === 'editorial' ? 'text-3xl leading-[1.15] sm:text-4xl lg:text-5xl' : 'text-3xl leading-tight sm:text-4xl') : 'text-2xl leading-snug']}>
    {title}
  </Heading>
  {description && <p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">{description}</p>}
</div>
