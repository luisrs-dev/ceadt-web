<a data-back-to-top href="#page-top" aria-label="Volver arriba, al menú principal" title="Volver arriba" class="fixed bottom-6 right-4 z-40 inline-flex size-12 items-center justify-center rounded-full border border-white/30 bg-primary text-on-primary shadow-card hover:bg-primary-hover sm:right-6">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-6"><path d="m6 12 6-6 6 6M12 6v13" stroke-linecap="round" stroke-linejoin="round"/></svg>
</a>
<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-back-to-top]');
  if (link) {
    const update = () => { link.hidden = window.scrollY < 500 && document.activeElement !== link; };
    let scheduled = false;
    window.addEventListener('scroll', () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => { scheduled = false; update(); });
    }, { passive: true });
    link.addEventListener('blur', update);
    link.addEventListener('click', (event) => {
      event.preventDefault();
      document.querySelector<HTMLElement>('#site-header a')?.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    });
    update();
  }
</script>
<style>
  [data-back-to-top] { bottom: max(1.5rem, env(safe-area-inset-bottom)); }
  [data-back-to-top][hidden] { display: none; }
</style>
