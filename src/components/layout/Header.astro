---
import Container from '../ui/Container.astro';
import MobileMenu from './MobileMenu.astro';
import { publicNavigation, isNavigationActive } from '../../data/navigation';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header id="site-header" class="sticky top-0 z-30 border-b border-primary-hover bg-primary text-on-primary">
  <Container class="flex min-h-24 items-center justify-between gap-4 py-3">
    <a href="/" aria-label="CEADT — Inicio" class="flex w-48 shrink-0 items-center gap-3 rounded-control focus-visible:outline-on-primary">
      <span aria-hidden="true" class="relative block h-14 w-16 shrink-0 overflow-hidden">
        <img src="/images/logo-ceadt.png" alt="" width="900" height="500" class="absolute -top-4 left-0 w-40 max-w-none" />
      </span>
      <span><span class="block text-2xl font-semibold tracking-tight text-on-primary">CEADT</span><span class="block text-[0.625rem] leading-snug text-on-primary">Tratamiento de adicciones</span></span>
    </a>
    <nav aria-label="Navegación principal" class="hidden xl:block">
      <ul class="flex flex-wrap items-center gap-5">
        {publicNavigation.map((item) => <li><a href={item.href} aria-current={isNavigationActive(currentPath, item.href) ? 'page' : undefined} class:list={['inline-flex min-h-11 items-center gap-1 border-b-2 py-2 text-sm text-on-primary focus-visible:outline-on-primary', isNavigationActive(currentPath, item.href) ? 'border-accent font-semibold' : 'border-transparent hover:border-on-primary']}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a href="/#contacto" class="hidden min-h-11 items-center justify-center gap-2 rounded-control border border-on-primary bg-on-primary px-5 py-2.5 text-center font-semibold leading-snug text-primary hover:bg-background-alt focus-visible:outline-on-primary sm:inline-flex">Solicitar información <span aria-hidden="true">↗</span></a>
      <MobileMenu currentPath={currentPath} />
    </div>
  </Container>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const updateHeight = () => {
      document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
    };
    updateHeight();
    new ResizeObserver(updateHeight).observe(header);
  }
</script>
