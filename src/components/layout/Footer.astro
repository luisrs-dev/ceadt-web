---
import Container from '../ui/Container.astro';
import { contacts } from '../../data/contact';
import { publicNavigation } from '../../data/navigation';
const year = new Date().getFullYear();
---
<footer class="bg-foreground py-12 text-white">
  <Container>
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.2fr_0.8fr_1fr_1fr]">
      <div>
        <a href="/" aria-label="CEADT — Inicio" class="relative block h-20 w-56 overflow-hidden rounded-control focus-visible:outline-white"><img src="/images/logo-ceadt.png" alt="CEADT" width="900" height="500" loading="lazy" class="absolute -top-6 left-0 w-56 max-w-none" /></a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/80">Centro Especialista en Tratamiento de Adicciones.</p>
        <p class="mt-4 text-sm text-white/80">Región del Maule, Chile.</p>
      </div>
      <nav aria-label="Navegación del pie">
        <h2 class="mb-4 text-base font-semibold">Explorar</h2>
        <ul class="space-y-1">{publicNavigation.map((item) => <li><a href={item.href} class="inline-block py-2 text-sm text-white/90 underline-offset-4 hover:underline focus-visible:outline-white">{item.label}</a></li>)}</ul>
      </nav>
      {contacts.map((contact) => <div>
        <h2 class="mb-4 text-base font-semibold">{contact.name}</h2>
        <ul class="space-y-2 text-sm">
          {contact.phones.map((phone) => <li><a href={phone.href} class="inline-block min-h-11 py-2 text-white/90 underline-offset-4 hover:underline focus-visible:outline-white">{phone.label}</a></li>)}
          <li><a href={`mailto:${contact.email}`} class="inline-block break-all py-2 text-white/90 underline-offset-4 hover:underline focus-visible:outline-white">{contact.email}</a></li>
        </ul>
      </div>)}
    </div>
    <div class="mt-10 flex flex-wrap justify-between gap-4 border-t border-white/20 pt-6 text-sm text-white/80">
      <p>© {year} CEADT. Todos los derechos reservados.</p>
    </div>
  </Container>
</footer>
