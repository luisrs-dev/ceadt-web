---
import type { FollowUpQuestion } from '../../data/follow-up-test';
interface Props { question: FollowUpQuestion; }
const { question } = Astro.props;
---
<fieldset data-followup-item data-question={question.id} class="min-w-0 rounded-card border border-border bg-surface p-5 sm:p-6">
  <legend class="max-w-full px-2 text-lg font-semibold leading-snug">{question.title}</legend>
  <p class="mb-4 text-sm text-muted">{question.type === 'checkbox' ? 'Puedes marcar más de una alternativa.' : 'Selecciona una alternativa.'}</p>
  <div class="grid gap-3 sm:grid-cols-2">
    {question.options.map((option, index) => <label class="flex cursor-pointer items-start gap-3 rounded-control border border-border p-4 hover:border-primary/50 has-checked:border-primary has-checked:bg-primary/5 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-focus">
      <input type={question.type} name={`followup-${question.id}`} value={String(index)} data-exclusive={option === question.exclusiveOption ? 'true' : undefined} class="mt-1 size-5 shrink-0 accent-primary" />
      <span data-option-label class="min-w-0 leading-relaxed text-muted">{option}</span>
    </label>)}
  </div>
</fieldset>
