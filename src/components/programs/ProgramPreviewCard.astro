---
import type { ProgramPreview } from '../../data/program-regions';
interface Props { program: ProgramPreview; }
const { program } = Astro.props;
---
<article class="flex min-w-0 flex-col items-start rounded-card border border-border bg-surface p-8 sm:p-10">
  <span class="rounded-control bg-background-alt px-3 py-2 text-xs font-semibold text-muted">Información pendiente</span>
  <p class="mt-8 text-sm font-semibold text-secondary">{program.modality}</p>
  <h3 class="mt-2 text-2xl font-semibold leading-snug">{program.title}</h3>
  <p class="mt-4 grow leading-relaxed text-muted">Este espacio presentará el programa, a quién está dirigido y cómo consultar sobre ingreso.</p>
  <p class="mt-8 border-t border-border pt-5 text-sm leading-relaxed text-muted">Descripción, ubicación, requisitos y contacto pendientes de confirmación.</p>
</article>
