---
import Button from '../ui/Button.astro';
import type { Contact } from '../../data/contact';
interface Props { contact: Contact; }
const { contact } = Astro.props;
const prefix = `referral-${contact.id}`;
const inputClass = 'mt-2 min-h-12 w-full min-w-0 rounded-control border border-primary/40 bg-surface px-4 py-3 text-foreground placeholder:text-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus';
const professionalFields = [
  { id: 'professional-first-name', label: 'Nombre', type: 'text' },
  { id: 'professional-last-name', label: 'Apellidos', type: 'text' },
  { id: 'role', label: 'Cargo', type: 'text' },
  { id: 'organization', label: 'Programa o institución derivadora', type: 'text' },
  { id: 'phone', label: 'Teléfono de contacto', type: 'tel' },
  { id: 'email', label: 'Correo electrónico', type: 'email' },
] as const;
---
<div class="min-w-0 rounded-card border border-border bg-background-alt p-5 sm:p-8 xl:p-10">
  <p class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-primary"><span aria-hidden="true" class="h-0.5 w-6 bg-secondary"></span>Solicitud de derivación</p>
  <h3 id={`${prefix}-title`} class="text-2xl font-semibold leading-snug">Derivar a {contact.name}</h3>
  <p id={`${prefix}-preview`} class="mt-4 rounded-control border border-border bg-surface p-4 text-sm leading-relaxed text-muted">Vista previa del formulario. Puedes probar los campos y seleccionar documentos; no se envían ni se guardan. Utiliza datos ficticios durante esta prueba.</p>
  <!-- method=dialog evita navegación/envío incluso sin el script de la vista previa. -->
  <form data-referral-preview method="dialog" autocomplete="off" aria-labelledby={`${prefix}-title`} aria-describedby={`${prefix}-preview`} class="mt-10 space-y-10">
    <fieldset class="min-w-0">
      <legend class="mb-5 text-lg font-semibold">Persona derivada</legend>
      <div class="grid gap-6 sm:grid-cols-2">
        <div><label for={`${prefix}-patient-first-name`} class="block text-sm font-semibold">Nombre</label><input id={`${prefix}-patient-first-name`} type="text" class={inputClass} /></div>
        <div><label for={`${prefix}-patient-last-name`} class="block text-sm font-semibold">Apellidos</label><input id={`${prefix}-patient-last-name`} type="text" class={inputClass} /></div>
      </div>
    </fieldset>
    <fieldset class="min-w-0 border-t border-border pt-6">
      <legend class="pr-3 text-lg font-semibold">Profesional responsable</legend>
      <div class="mt-3 grid gap-6 sm:grid-cols-2">
        {professionalFields.map((field) => <div class:list={['min-w-0', { 'sm:col-span-2': field.id === 'organization' || field.id === 'email' }]}><label for={`${prefix}-${field.id}`} class="block text-sm font-semibold">{field.label}</label><input id={`${prefix}-${field.id}`} type={field.type} class={inputClass} /></div>)}
      </div>
    </fieldset>
    <fieldset class="min-w-0 border-t border-border pt-6">
      <legend class="pr-3 text-lg font-semibold">Documentos y antecedentes</legend>
      <label for={`${prefix}-documents`} class="mt-3 block text-sm font-semibold">Ficha o informe de derivación</label>
      <div class="mt-3 min-w-0 rounded-control border border-dashed border-primary/50 bg-surface p-4 sm:p-5">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-3 size-7 text-primary"><path d="M12 16V3m-5 5 5-5 5 5M4 15v5h16v-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <p id={`${prefix}-documents-help`} class="mb-4 text-sm leading-relaxed text-muted">Selecciona uno o varios documentos de prueba. Los archivos permanecen en tu dispositivo.</p>
        <input id={`${prefix}-documents`} data-referral-files type="file" multiple aria-describedby={`${prefix}-documents-help`} class="block min-h-11 w-full min-w-0 max-w-full text-sm text-muted file:mr-3 file:cursor-pointer file:rounded-control file:border-0 file:bg-primary file:px-4 file:py-3 file:font-semibold file:text-on-primary hover:file:bg-primary-hover" />
        <ul data-referral-file-list aria-live="polite" aria-atomic="true" class="mt-4 space-y-2 break-all text-sm text-muted"></ul>
      </div>
      <label for={`${prefix}-details`} class="mt-6 block text-sm font-semibold">Detalles de la derivación</label>
      <textarea id={`${prefix}-details`} rows="5" class:list={[inputClass, 'resize-y']} aria-describedby={`${prefix}-preview`}></textarea>
    </fieldset>
    <div class="space-y-4 border-t border-border pt-6">
      <Button type="submit" disabled class="w-full" aria-describedby={`${prefix}-preview`}>Enviar derivación <span aria-hidden="true">↗</span></Button>
      <Button type="reset" variant="outline" class="w-full">Limpiar formulario</Button>
      <p class="text-center text-sm text-muted">El envío se habilitará cuando esté disponible el canal de recepción.</p>
    </div>
  </form>
</div>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-referral-preview]').forEach((form) => {
    form.addEventListener('submit', (event) => event.preventDefault());
    const input = form.querySelector<HTMLInputElement>('[data-referral-files]');
    const list = form.querySelector<HTMLUListElement>('[data-referral-file-list]');
    input?.addEventListener('change', () => {
      if (!list) return;
      list.replaceChildren();
      for (const file of Array.from(input.files ?? [])) {
        const item = document.createElement('li');
        item.textContent = file.name;
        list.append(item);
      }
    });
    form.addEventListener('reset', () => list?.replaceChildren());
  });
</script>
