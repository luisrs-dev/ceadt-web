---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { contacts } from '../../data/contact';
---
<section id="contacto" aria-labelledby="contact-title" class="py-16 sm:py-20 lg:py-28">
  <Container>
    <SectionHeading size="editorial" id="contact-title" eyebrow="Contacto" title="Conversemos sobre tu consulta" description="Contactos de CEADT Hombres y CEADT Mujeres para solicitar información." />
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      {contacts.map((contact) => <article id={`contacto-${contact.id}`} class="min-w-0 rounded-card border border-border bg-background-alt p-8 sm:p-10">
        <h3 class="text-2xl font-semibold">{contact.name}</h3>
        <p class="mt-6 text-sm font-medium text-muted">Contacto telefónico</p>
        <div class="mt-3 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap">
          {contact.phones.map((phone) => <Button href={phone.href} aria-label={`Llamar a ${contact.name} al ${phone.label}`}>{phone.label}</Button>)}
        </div>
        <p class="mt-6 text-sm text-muted">Correo electrónico</p>
        <a href={`mailto:${contact.email}`} class="mt-2 inline-block max-w-full break-all py-2 font-semibold text-primary underline underline-offset-4 hover:text-primary-hover">{contact.email}</a>
        <div class="mt-6 border-t border-border pt-6">
          <p class="text-sm text-muted">Ubicación</p>
          <iframe
            src={`${contact.mapsUrl}&output=embed`}
            title={`Mapa de ubicación de ${contact.name}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            class="mt-4 h-72 w-full rounded-control border border-border bg-surface sm:h-80"
          ></iframe>
          <a href={contact.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex min-h-11 items-center gap-2 py-2 font-semibold text-primary underline underline-offset-4 hover:text-primary-hover">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="size-5 shrink-0"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="12" cy="10" r="2.5" /></svg>
            Ver ubicación en Google Maps<span class="sr-only"> de {contact.name} (se abre en otra pestaña)</span><span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>)}
    </div>
  </Container>
</section>
