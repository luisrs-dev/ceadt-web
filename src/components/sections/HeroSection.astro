---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import homeImage from '../../assets/home.jpg';

interface Props {
  variant?: 'split' | 'cover';
  headingLevel?: 'h1' | 'h2';
}
const { variant = 'split', headingLevel: Heading = 'h1' } = Astro.props;
const isCover = variant === 'cover';
const titleId = isCover ? 'cover-hero-title' : 'hero-title';
---
<section aria-labelledby={titleId} class:list={[
  'relative isolate border-b border-border',
  isCover ? 'flex min-h-[clamp(32rem,78svh,46rem)] items-center bg-foreground py-16 text-white sm:py-24 lg:py-28' : 'bg-background-alt py-12 sm:py-16 lg:py-20',
]}>
  {isCover && <>
    <Image src={homeImage} alt="" widths={[480, 768, 1024, 1280, 1920]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_55%] sm:object-center" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/55"></div>
  </>}
  <Container class={isCover ? 'text-center' : 'grid items-center gap-10 lg:grid-cols-2 lg:gap-16'}>
    <div class:list={{ 'mx-auto max-w-5xl': isCover }}>
      <p class:list={['mb-5 flex items-center gap-3 text-sm font-semibold', isCover ? 'justify-center text-white' : 'text-primary']}><span aria-hidden="true" class="h-px w-8 bg-secondary"></span>CEADT · Región del Maule</p>
      <Heading id={titleId} class="text-4xl font-semibold leading-tight tracking-tight text-balance sm:text-5xl lg:text-6xl">Un espacio de apoyo para construir nuevos comienzos</Heading>
      <p class:list={['mt-6 max-w-reading text-lg leading-relaxed', isCover ? 'mx-auto text-white' : 'text-muted']}>En CEADT brindamos atención especializada en el tratamiento de adicciones, acompañando procesos de rehabilitación y reinserción social.</p>
      <div class:list={['mt-8 flex flex-col gap-4 sm:flex-row sm:flex-wrap', { 'justify-center': isCover }]}>
        <Button href="/programas" size="lg" class={isCover ? 'focus-visible:outline-white' : undefined}>Conoce nuestros programas</Button>
        <Button href="#contacto" variant="outline" size="lg" class={isCover ? 'focus-visible:outline-white' : undefined}>Contáctanos</Button>
      </div>
    </div>
    {!isCover && <figure class="relative">
      <Image src={homeImage} alt="Patio e instalaciones de CEADT, con vegetación, piscina y edificios de tejas." widths={[480, 768, 1024, 1440]} sizes="(min-width: 1152px) 512px, (min-width: 1024px) 45vw, 92vw" format="webp" loading="lazy" class="aspect-4/3 w-full rounded-card object-cover lg:min-h-112" />
      <figcaption class="mt-3 text-sm text-muted">Instalaciones CEADT · Fotografía del centro</figcaption>
    </figure>}
  </Container>
</section>
