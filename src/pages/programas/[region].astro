---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Container from '../../components/ui/Container.astro';
import ProgramList from '../../components/programs/ProgramList.astro';
import Button from '../../components/ui/Button.astro';
import { orientationWhatsApp } from '../../data/contact';
import { programRegions, getRegionalProgramGroups, type ProgramRegion } from '../../data/program-regions';
export function getStaticPaths() {
  return programRegions.map((region) => ({ params: { region: region.id }, props: { region } }));
}
interface Props { region: ProgramRegion; }
const { region } = Astro.props;
const groups = getRegionalProgramGroups(region);
const description = `Conoce los programas de CEADT en la ${region.title} y la información disponible para solicitar orientación.`;
---
<BaseLayout title={`Programas — ${region.title}`} description={description}>
  <Header slot="header" />
  <PageHeader title={`Programas en la ${region.title}`} description={region.description} breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Programas', href: '/programas' }, { label: region.title }]} />
  <section aria-label="Programas por modalidad" class="py-16 sm:py-20">
    <Container>
      <ProgramList groups={groups} />
      <a href="/programas" class="mt-10 inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4">Ver otras regiones</a>
    </Container>
  </section>
  <section aria-labelledby="region-contact-title" class="bg-background-alt py-12 sm:py-16">
    <Container class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center sm:gap-10">
      <div>
        <h2 id="region-contact-title" class="text-2xl font-semibold text-primary">¿Necesitas orientación?</h2>
        <p class="mt-3 max-w-reading leading-relaxed text-muted">Si no sabes qué programa consultar, comunícate con CEADT para solicitar información.</p>
      </div>
      <Button href={orientationWhatsApp ? `https://wa.me/${orientationWhatsApp.number.replace(/\D/g, '')}` : '/#contacto'} class="shrink-0">Solicitar información</Button>
    </Container>
  </section>
  <Footer slot="footer" />
</BaseLayout>
