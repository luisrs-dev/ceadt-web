---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Container from '../../components/ui/Container.astro';
import RegionLinks from '../../components/programs/RegionLinks.astro';
---
<BaseLayout title="Programas" description="Elige una región para conocer los programas de CEADT.">
  <Header slot="header" />
  <PageHeader title="Nuestros programas" description="Elige una región para conocer sus programas y la información de contacto disponible." breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Programas' }]} />
  <section aria-label="Elige una región" class="py-16 sm:py-20"><Container><RegionLinks /></Container></section>
  <Footer slot="footer" />
</BaseLayout>
