---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { news, formatNewsDate, type NewsArticle } from '../../data/news';
export function getStaticPaths() {
  return news.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
interface Props { article: NewsArticle; }
const { article } = Astro.props;
---
<BaseLayout title={article.title} description={article.summary}>
  <Fragment slot="head">
    <meta property="og:title" content={`${article.title} | CEADT`} />
    <meta property="og:description" content={article.summary} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="es_CL" />
    <meta property="article:published_time" content={`${article.publishedAt}T00:00:00Z`} />
  </Fragment>
  <Header slot="header" />
  <article class="py-10 sm:py-14 lg:py-16">
    <Container width="reading">
      <nav aria-label="Ruta de navegación" class="mb-8 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-3">
          <li><a href="/" class="inline-block py-2 underline underline-offset-4 hover:text-primary">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/noticias" class="inline-block py-2 underline underline-offset-4 hover:text-primary">Noticias</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Publicación</li>
        </ol>
      </nav>
      <header>
        <p class="text-sm font-semibold text-secondary">Noticias · <time datetime={article.publishedAt}>{formatNewsDate(article.publishedAt)}</time></p>
        <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-balance sm:text-4xl lg:text-5xl">{article.title}</h1>
      </header>
      <Image src={article.image} alt={article.imageAlt} widths={[320, 400]} sizes="(min-width: 640px) 400px, calc(100vw - 32px)" format="webp" loading="eager" fetchpriority="high" class="mx-auto mt-10 h-auto w-full max-w-[400px] rounded-card" />
      <p class="mt-8 border-l-2 border-secondary pl-4 text-sm leading-relaxed text-muted">Publicación del {formatNewsDate(article.publishedAt)}. La información corresponde a esa fecha.</p>
      <div class="mt-8 space-y-6 text-lg leading-relaxed">
        {article.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {article.sections?.map((section) => <section class="mt-10 space-y-6">
          <h2 class="text-2xl font-semibold leading-snug text-foreground">{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>)}
      </div>
      <div class="mt-12 border-t border-border pt-8"><Button href="/noticias" variant="outline">← Volver a noticias</Button></div>
    </Container>
  </article>
  <Footer slot="footer" />
</BaseLayout>
