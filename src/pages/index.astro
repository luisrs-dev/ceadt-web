---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ProgramsSection from '../components/sections/ProgramsSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---
<BaseLayout title="Inicio" description="CEADT, Centro Especialista en Tratamiento de Adicciones. Información institucional, programas por región y canales de contacto.">
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="CEADT" />
    <meta property="og:title" content="CEADT | Un espacio de apoyo para construir nuevos comienzos" />
    <meta property="og:description" content="Conoce CEADT, explora sus programas por región y encuentra los canales de contacto disponibles." />
  </Fragment>
  <Header slot="header" />
  <HeroSection variant="cover" />
  <AboutSection />
  <ProgramsSection />
  <ContactSection />
  <Footer slot="footer" />
</BaseLayout>
