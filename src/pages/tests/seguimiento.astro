---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import Container from '../../components/ui/Container.astro';
import FollowUpQuestionnaire from '../../components/tests/FollowUpQuestionnaire.astro';
const description = 'Cuestionario de seguimiento para personas egresadas de CEADT sobre tratamiento, abstinencia, consumo posterior y contacto con sus terapeutas.';
---
<BaseLayout title="Test de Seguimiento" description={description}>
  <Fragment slot="head"><meta property="og:title" content="Test de Seguimiento | CEADT" /><meta property="og:description" content={description} /><meta property="og:type" content="website" /></Fragment>
  <Header slot="header" />
  <PageHeader title="Test de Seguimiento" description="Usuarios y usuarias de CEADT · Revisa tus antecedentes y experiencia después del egreso." breadcrumbs={[{label: 'Inicio', href: '/'}, {label: 'Tests', href: '/tests'}, {label: 'Seguimiento'}]} />
  <Container width="reading" class="py-12 sm:py-16 lg:py-20"><FollowUpQuestionnaire /></Container>
  <Footer slot="footer" />
</BaseLayout>
